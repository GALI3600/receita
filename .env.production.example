# Configuração de produção (docker-compose.prod.yml). Copie para .env.production (fora do git),
# preencha e suba com:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Os segredos vêm vazios de propósito: o Compose e a API se recusam a subir sem eles.
# Gere cada um com:  openssl rand -hex 32
# (só letras e números nas senhas do banco e do Redis: elas entram em URLs de conexão)

# --- Domínio e HTTPS (Caddy) ------------------------------------------------------------------
# Domínio do site, com o DNS (A/AAAA) já apontando para a VPS. O Caddy pede o certificado ao
# Let's Encrypt sozinho. DOMAIN=localhost usa a CA interna do Caddy (só para teste local).
DOMAIN=receita.example.com
# E-mail para a conta ACME (avisos de expiração do certificado).
ACME_EMAIL=voce@example.com
# Portas publicadas no host (mude só em teste local, para não conflitar com outro serviço).
HTTP_PORT=80
HTTPS_PORT=443
# Duração do HSTS em segundos (1 ano). Comece menor (ex.: 300) se ainda estiver testando o domínio.
HSTS_MAX_AGE=31536000

# --- Segredos dos serviços internos -------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- API ---------------------------------------------------------------------------------------
# ENVIRONMENT=production, DATABASE_URL, REDIS_URL, TRUST_PROXY_HEADERS=true, LOG_FORMAT=json e
# ACCESS_LOG=true já vêm do docker-compose.prod.yml (montados a partir das senhas acima).
# Em produção a API recusa subir sem SECRET_KEY (32+ caracteres) e sem SMTP_HOST.
SECRET_KEY=
ANTHROPIC_API_KEY=
# Origem do site (JSON): o CORS e a checagem de CSRF só aceitam pedidos dela.
CORS_ORIGINS=["https://receita.example.com"]
# Base dos links dos e-mails (/verificar-email?token=..., /redefinir-senha?token=...).
FRONTEND_URL=https://receita.example.com
# Processos do uvicorn (cada um ~150 MB de RAM). 2 aguenta bem uma VPS pequena.
API_WORKERS=2
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# --- E-mail (SMTP) -----------------------------------------------------------------------------
# Qualquer provedor SMTP (Resend, Brevo, Amazon SES, Postmark...). O remetente precisa ser de
# um domínio verificado no provedor (SPF/DKIM).
EMAIL_BACKEND=smtp
EMAIL_FROM=Receita <nao-responda@receita.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) ou none (só servidor local de teste).
SMTP_SECURITY=starttls
SMTP_TIMEOUT_S=10

# --- Captcha (Cloudflare Turnstile) -------------------------------------------------------------
# As duas chaves do mesmo widget. A do site é pública e vai para o JS no build do frontend
# (mudou: rode de novo com --build). Vazias: cadastro sem captcha.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Limites e custo ---------------------------------------------------------------------------
# Por IP, janela fixa: "<pedidos>/<second|minute|hour|day>".
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/hour
RATE_LIMIT_RESEND_VERIFICATION=5/hour
RATE_LIMIT_IMPORTS=30/hour
RATE_LIMIT_VERIFICATION_EMAIL_PER_ADDRESS=5/day
# Receitas novas por usuário por dia UTC (cópias e falhas não contam).
DAILY_IMPORT_LIMIT=10
DAILY_FAILED_IMPORT_LIMIT=20
# Teto do gasto diário (UTC) com o Claude, em US$. Ao atingir, vídeos novos ficam "deferred" e
# voltam à fila às 00:05 UTC. 0 pausa as receitas novas.
DAILY_LLM_BUDGET_USD=10

# --- Pipeline ------------------------------------------------------------------------------------
MAX_VIDEO_DURATION_MIN=60
# Cookies de uma conta do YouTube se o IP da VPS for barrado como robô: ponha o arquivo em
# deploy/secrets/ e aponte para /run/receita/<arquivo> (veja docs/DEPLOY.md). Vazio: sem cookies.
YTDLP_COOKIES_FILE=
WHISPER_MODEL=small
# cpu, ou cuda com GPU NVIDIA (WHISPER_COMPUTE_TYPE=float16; veja docs/DEPLOY.md).
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Transcrições simultâneas (cada uma ocupa CPU e ~1–2 GB de RAM).
WHISPER_MAX_JOBS=1
IMPORT_JOB_TIMEOUT_S=900
WHISPER_JOB_TIMEOUT_S=3600
IMPORT_MAX_RETRIES=2
IMPORT_RETRY_DELAY_S=30
IMPORT_STALE_AFTER_MIN=360

# --- Rede interna (mude só se a faixa conflitar com outra rede da VPS) --------------------------
PROXY_SUBNET=172.31.250.0/24
CADDY_IP=172.31.250.10

# --- Backups (scripts/backup-db.sh) ------------------------------------------------------------
BACKUP_DIR=/var/backups/receita
BACKUP_KEEP_DAYS=14
