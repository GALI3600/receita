# development: cookie de sessão sem Secure, SECRET_KEY de desenvolvimento e e-mails só no log.
# O padrão é production, que exige SECRET_KEY e SMTP_HOST.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://receita:receita@localhost:5432/receita
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
# Origens do site (JSON). Também valem para o CSRF: um Origin fora daqui é recusado.
CORS_ORIGINS=["http://localhost:5173"]

# --- Contas -----------------------------------------------------------------------------------
# Assina sessões e links de e-mail; obrigatório (32+ caracteres) fora de development.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Base dos links dos e-mails (/verificar-email?token=..., /redefinir-senha?token=...).
FRONTEND_URL=http://localhost:5173
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# console (o e-mail vai para o log da API; padrão em development) ou smtp (padrão fora dele).
EMAIL_BACKEND=console
EMAIL_FROM=Receita <nao-responda@receita.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) ou none.
SMTP_SECURITY=starttls
# Segundos de espera pelo servidor SMTP (conexão e cada comando) antes de desistir do envio.
SMTP_TIMEOUT_S=10

# Cloudflare Turnstile no cadastro; vazio desliga o captcha.
TURNSTILE_SECRET_KEY=

# --- Limites ----------------------------------------------------------------------------------
# true só com um proxy reverso na frente que acrescenta o IP real ao X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Por IP, janela fixa: "<pedidos>/<second|minute|hour|day>".
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/hour
RATE_LIMIT_RESEND_VERIFICATION=5/hour
RATE_LIMIT_IMPORTS=30/hour
# Por endereço (de qualquer IP): e-mails de confirmação, somando cadastro e reenvios.
RATE_LIMIT_VERIFICATION_EMAIL_PER_ADDRESS=5/day
# Receitas novas (que chamam o Claude) por usuário por dia UTC; cópias e falhas não contam.
DAILY_IMPORT_LIMIT=10
# Imports por usuário por dia UTC que falharam depois de chamar o Claude ou passar pelo whisper
# (ex.: vídeos que não são receita): não gastam a cota, mas têm este limite próprio.
DAILY_FAILED_IMPORT_LIMIT=20
# Teto do gasto diário (UTC) com o Claude, em US$; ao atingir, vídeos novos ficam para o dia
# seguinte (status deferred). 0 pausa as receitas novas.
DAILY_LLM_BUDGET_USD=10

# --- Pipeline ---------------------------------------------------------------------------------
MAX_VIDEO_DURATION_MIN=60
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_JOBS=1
# Tempo máximo de um job de import e de uma transcrição com o whisper, em segundos.
IMPORT_JOB_TIMEOUT_S=900
WHISPER_JOB_TIMEOUT_S=3600
# Novas tentativas (com espera crescente, em segundos) depois de falhas transitórias.
IMPORT_MAX_RETRIES=2
IMPORT_RETRY_DELAY_S=30
# Imports parados há mais tempo que isso (em minutos) são dados como falhos pelo worker.
IMPORT_STALE_AFTER_MIN=360
