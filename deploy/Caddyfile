# Proxy de produção do Receita (docker-compose.prod.yml).
#
# - HTTPS automático para {$DOMAIN} (Let's Encrypt; com DOMAIN=localhost, a CA interna do Caddy);
# - serve o build do frontend (/srv) com fallback de SPA e cache longo dos assets com hash;
# - /api/* vai para a API sem o prefixo (/api/auth/me → /auth/me), como o proxy do Vite em dev;
# - headers de segurança em todas as respostas, inclusive nas de erro (handle_errors).
#
# Depois de editar: docker compose -f docker-compose.prod.yml --env-file .env.production \
#   exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}

	# Atrás do proxy do Cloudflare (nuvem laranja), o Caddy recebe as conexões dos servidores do
	# Cloudflare: descomente para que o IP do cliente ({client_ip}, repassado à API no
	# X-Forwarded-For) venha do CF-Connecting-IP, mas só quando a conexão vem dos IPs dele
	# (lista atual em https://www.cloudflare.com/ips/). Sem o Cloudflare, deixe comentado: um
	# CF-Connecting-IP mandado pelo próprio cliente seria forjado.
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# 	client_ip_headers CF-Connecting-IP
	# 	trusted_proxies_strict
	# }
}

# Headers de segurança: aplicados às respostas normais e de novo em handle_errors, porque o
# bloco de header com "-Server" é adiado (aplicado na escrita) e não chega às respostas de erro.
(security_headers) {
	header {
		# HSTS_MAX_AGE=0 só no teste local (https://localhost), para o navegador não guardar HSTS.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
		# YouTube IFrame API (script em www.youtube.com, player em youtube-nocookie.com, capas
		# em i.ytimg.com), Cloudflare Turnstile (script + iframe) e Google Fonts. Os estilos
		# inline ficam liberados porque os widgets de terceiros os usam; scripts inline, não.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com https://i9.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://challenges.cloudflare.com; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}
}

{$DOMAIN} {
	encode zstd gzip
	import security_headers

	# API: sem o prefixo /api. O X-Forwarded-For é sobrescrito com o IP do cliente (o que se
	# conectou ao Caddy, ou o do CF-Connecting-IP com o bloco do Cloudflare acima): qualquer
	# X-Forwarded-For mandado pelo cliente é descartado, e a API (TRUST_PROXY_HEADERS=true) usa
	# o último endereço do header para o rate limit.
	handle_path /api/* {
		request_body {
			max_size 1MB
		}
		header ?Cache-Control "no-store"
		# tcp4: a API só escuta em IPv4 e o --forwarded-allow-ips dela é o CADDY_IP (IPv4); a
		# rede do Compose também tem IPv6, e o nome "api" resolveria para os dois.
		reverse_proxy tcp4/api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Assets do Vite têm hash no nome: cache de um ano. Arquivo que não existe dá 404 (sem
	# fallback para o index.html, que seria guardado em cache como se fosse o JS) e cai no
	# handle_errors abaixo, sem o cache longo.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# O resto é a SPA: arquivo se existir, senão o index.html (o React Router resolve a rota).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Erros do próprio Caddy (asset inexistente, API fora do ar → 502): mesmos headers de
	# segurança, sem cache.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}

	# Log de acesso em JSON. Cookie e Authorization já saem ocultos; o token dos links de
	# confirmação e de redefinição de senha (/verificar-email?token=...) também é apagado, na
	# URL e no Referer: a página do link carrega os assets antes de o React tirar o token da
	# URL, e o navegador manda a URL inteira no Referer dos pedidos para a mesma origem.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
			}
			request>headers>Referer regexp "token=[^&#]*" "token=REDACTED"
		}
	}
}
