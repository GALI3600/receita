# Variáveis do teste local do stack de produção (docker-compose.prod.test.yml).
# Segredos falsos de propósito: este arquivo está no git e NUNCA deve ir para uma VPS.
COMPOSE_PROJECT_NAME=receita-prod-test
ENV_FILE=deploy/local-test.env

DOMAIN=localhost
ACME_EMAIL=teste@example.com
HTTP_PORT=8080
HTTPS_PORT=8443
HSTS_MAX_AGE=0
PROXY_SUBNET=172.31.251.0/24
CADDY_IP=172.31.251.10

POSTGRES_PASSWORD=teste0local0postgres0nao0use0em0producao
REDIS_PASSWORD=teste0local0redis0nao0use0em0producao
SECRET_KEY=teste-local-nao-use-em-producao-0123456789abcdef

CORS_ORIGINS=["https://localhost:8443"]
FRONTEND_URL=https://localhost:8443
API_WORKERS=2

EMAIL_BACKEND=smtp
EMAIL_FROM=Receita <nao-responda@receita.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none

# O worker do whisper baixaria o modelo; no teste, o tiny basta para ele ficar saudável.
WHISPER_MODEL=tiny
