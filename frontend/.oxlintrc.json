{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/test/**",
        "src/**/*.test.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
